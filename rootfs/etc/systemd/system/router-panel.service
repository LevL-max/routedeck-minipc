[Unit]
Description=Mini-PC Router LAN Control Panel
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/router-panel/router-panel.py
Restart=on-failure
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
