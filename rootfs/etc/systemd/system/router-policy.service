[Unit]
Description=Restore policy routing tables (awg / tun0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '
  # ensure awg table exists
  grep -q "^100 awg$" /etc/iproute2/rt_tables || echo "100 awg" >> /etc/iproute2/rt_tables

  # awg routing
  ip route replace default dev wg0 table awg
  ip rule add fwmark 0x1 lookup awg priority 100 2>/dev/null || true

  # future tun0 (inactive until used)
  # ip route replace default dev tun0 table tun0
  # ip rule add fwmark 0x2 lookup tun0 priority 110 2>/dev/null || true
'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
