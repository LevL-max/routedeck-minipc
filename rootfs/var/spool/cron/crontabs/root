PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin


# AWG watchdog (runs only in awg mode)
* * * * * test "$(cat /etc/router/mode 2>/dev/null)" = "awg" && /usr/bin/flock -n /run/watchdog-rotator.lock /usr/local/sbin/watchdog-rotator >> /var/log/watchdog-rotator.log 2>&1
0 1 * * * /usr/bin/flock -x /run/watchdog-rotator.lock sh -c 'tail -n 1500 /var/log/watchdog-rotator.log > /var/log/watchdog-rotator.log.tmp && mv /var/log/watchdog-rotator.log.tmp /var/log/watchdog-rotator.log'



# TUN / VLESS rotator (runs only in tun mode)
# NOTE: no outer flock here because tun-rotator already locks internally
* * * * * test "$(cat /etc/router/mode 2>/dev/null)" = "tun" && /usr/local/sbin/tun-rotator >> /var/log/tun-rotator.log 2>&1
0 1 * * * /usr/bin/tail -n 1500 /var/log/tun-rotator.log > /var/log/tun-rotator.log.tmp && /bin/mv /var/log/tun-rotator.log.tmp /var/log/tun-rotator.log

# Boot safety
@reboot sleep 30 && /usr/local/sbin/router-restore-runtime >/dev/null 2>&1
@reboot /usr/bin/cpupower frequency-set -g performance
