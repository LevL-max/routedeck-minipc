# routedeck host profile - template. Copy this directory, edit the values, then:
#   sudo ./install.sh --profile /path/to/your/profile --no-secrets
# A profile directory may also hold authorized_keys (added for user ubuntu) and
# secrets.tar.gpg (your keys and proxy configs, see README).
PROFILE=example
DEVICE="Mini-PC"
HOSTNAME=minipc
# Ethernet ports. install.sh detects the real ones (or pass --wan / --lan).
WAN_IF=enp2s0
LAN_IF=eno1
# Fixed for this router type: LAN 192.168.50.1/24, DHCP .100-.200.
LAN_CIDR=192.168.50.0/24
# Badge and colour in the panel header.
PANEL_LABEL="Router"
PANEL_COLOR="#2563eb"
# Extra networks the panel answers besides the LAN: comma-separated CIDRs or empty.
TRUSTED_NET=
# Traffic mode after installation: direct | awg | tun | mihomo
MODE=direct
CPU_BOOST=off
# WAN name written inside the proxy configs of a secrets bundle (if you have one).
SECRETS_WAN_IF=enp2s0
